#!/usr/bin/env bash
#
# pre-commit — เรียก gate ชั้นเร็ว
#
# hook อยู่ในโฟลเดอร์นี้ (ไม่ใช่ .git/hooks) เพราะ .git/hooks ไม่ถูก track
# คนที่ clone ไปใหม่ต้องรันครั้งเดียว:  git config core.hooksPath .githooks
#
# ข้ามได้ด้วย git commit --no-verify — ตั้งใจให้ข้ามได้
# ด่านที่ปิดช่องนั้นคือ CI ไม่ใช่ hook

exec ./gate.sh
