#!/usr/bin/env bash
#
# pre-push — เรียก gate ก่อนโค้ดออกจากเครื่อง
#
# ทำไมอยู่ที่ push ไม่ใช่ commit:
#   เหตุผลที่ต้องคุมเวลา gate คือ "อย่าให้คนอยากข้าม" ซึ่งขึ้นกับ *ความถี่*
#   commit เกิดวันละหลายสิบครั้ง → 15 วิต่อครั้งน่ารำคาญ → คนใส่ --no-verify
#   push เกิดวันละไม่กี่ครั้ง    → 15 วิต่อครั้งรับได้สบาย → ไม่มีใครอยากข้าม
#
#   ย้ายมาตรงนี้จึงได้ tsc เต็มรูปแบบ ไม่ต้องตัด .next/types ออกเพื่อความเร็ว
#   = ไม่ลด coverage ไม่ขัดหลัก "gate ต้องตรงกับโหมดพังจริง"
#   และยังจับได้ก่อนโค้ดออกจากเครื่องอยู่ดี
#
# ข้ามได้ด้วย git push --no-verify — ด่านที่ปิดช่องนั้นคือ CI

exec ./gate.sh
