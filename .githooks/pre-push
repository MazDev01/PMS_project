#!/usr/bin/env bash
#
# pre-push — เรียก gate ชั้นเต็มก่อนโค้ดออกจากเครื่อง
#
# ทำไมอยู่ที่ push ไม่ใช่ commit:
#   โปรเจกต์นี้ไม่มี TypeScript และไม่มี eslint → ไม่มีเครื่องมือใดที่เร็วพอสำหรับ pre-commit
#   ด่านเดียวที่ตรวจอะไรได้จริงคือ next build (205 วิ) + smoke ซึ่งช้าเกินกว่าจะรันทุก commit
#
#   ถ้าเอาไปไว้ pre-commit คนจะกด --no-verify ภายในวันเดียว แล้วทั้งระบบพัง
#   ที่ push จึงเป็นที่เดียวที่ทั้ง "ตรวจจริง" และ "คนยอมรอ"
#
# ⚠ ใช้เวลาหลายนาที ถ้ารู้สึกว่านานเกินไป ทางแก้ที่ถูกคือเพิ่มด่านเร็ว (eslint)
#   ไม่ใช่ถอด gate ออก
#
# ข้ามได้ด้วย git push --no-verify — ด่านที่ปิดช่องนั้นคือ CI

exec ./gate.sh --full
